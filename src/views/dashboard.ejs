<%- include('partials/head') %>
<body class="bg-paper text-slate-800 antialiased">
  <div class="flex min-h-screen flex-col md:flex-row">
    <%- include('partials/sidebar') %>

    <main class="flex-1 px-5 py-8 md:px-10" id="dashboard"
          data-address="<%= user.address %>">
      <h1 class="text-2xl font-semibold text-ink-900">Dashboard</h1>
      <p class="mt-1 text-slate-500">Kamu login sebagai pemilik wallet di bawah.</p>

      <div class="mt-8 grid max-w-3xl gap-5">
        <section class="rounded-xl border border-slate-200 bg-white p-5">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-sm font-medium text-slate-500">Wallet address</h2>
            <button type="button" data-copy="<%= user.address %>"
                    class="rounded-md px-2 py-1 text-xs font-medium text-fox-600 hover:bg-orange-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-fox-500">Copy</button>
          </div>
          <p class="mt-2 break-all font-mono text-sm text-ink-900"><%= user.address %></p>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-5">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-sm font-medium text-slate-500">Public key (compressed)</h2>
            <button type="button" data-copy="<%= user.compressedPublicKey %>"
                    class="rounded-md px-2 py-1 text-xs font-medium text-fox-600 hover:bg-orange-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-fox-500">Copy</button>
          </div>
          <p class="mt-2 break-all font-mono text-sm text-ink-900"><%= user.compressedPublicKey %></p>

          <details class="mt-4">
            <summary class="cursor-pointer text-sm font-medium text-slate-500 hover:text-ink-900">Lihat versi uncompressed</summary>
            <div class="mt-3 flex items-start justify-between gap-3">
              <p class="break-all font-mono text-sm text-ink-900"><%= user.publicKey %></p>
              <button type="button" data-copy="<%= user.publicKey %>"
                      class="shrink-0 rounded-md px-2 py-1 text-xs font-medium text-fox-600 hover:bg-orange-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-fox-500">Copy</button>
            </div>
          </details>
        </section>

        <section class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5">
          <div>
            <h2 class="text-sm font-medium text-slate-500">Saldo</h2>
            <p class="mt-1 text-2xl font-semibold text-ink-900"><span id="balance">…</span> <span id="symbol" class="text-base font-medium text-slate-500">ETH</span></p>
            <p id="network" class="mt-1 text-sm text-slate-500"></p>
          </div>
          <a href="/transfer"
             class="rounded-xl bg-fox-500 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-fox-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-fox-500 focus-visible:ring-offset-2">
            Transfer
          </a>
        </section>
      </div>
    </main>
  </div>

  <script src="/vendor/ethers.js"></script>
  <script src="/js/wallet-info.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
