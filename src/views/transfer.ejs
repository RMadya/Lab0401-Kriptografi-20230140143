<%- include('partials/head') %>
<body class="bg-paper text-slate-800 antialiased">
  <div class="flex min-h-screen flex-col md:flex-row">
    <%- include('partials/sidebar') %>

    <main class="flex-1 px-5 py-8 md:px-10" id="transfer-page" data-address="<%= user.address %>">
      <h1 class="text-2xl font-semibold text-ink-900">Transfer</h1>
      <p class="mt-1 text-slate-500">Kirim ETH dari wallet kamu. Transaksi ditandatangani di MetaMask.</p>

      <div class="mt-8 max-w-xl rounded-xl border border-slate-200 bg-white p-6">
        <dl class="mb-6 grid gap-3 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-slate-500">Dari</dt>
            <dd class="break-all text-right font-mono text-ink-900"><%= user.address %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-slate-500">Network</dt>
            <dd id="network" class="text-right text-ink-900">…</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-slate-500">Saldo</dt>
            <dd class="text-right text-ink-900"><span id="balance">…</span> <span id="symbol">ETH</span></dd>
          </div>
        </dl>

        <form id="transfer-form" class="grid gap-4" novalidate>
          <label class="grid gap-1.5 text-sm font-medium text-slate-700">
            Alamat tujuan
            <input id="to" name="to" type="text" autocomplete="off" spellcheck="false" placeholder="0x…"
                   class="rounded-lg border border-slate-300 px-3 py-2.5 font-mono text-sm text-ink-900 focus:border-fox-500 focus:outline-none focus:ring-2 focus:ring-fox-500/30" />
          </label>

          <label class="grid gap-1.5 text-sm font-medium text-slate-700">
            Jumlah (ETH)
            <input id="amount" name="amount" type="text" inputmode="decimal" autocomplete="off" placeholder="0.01"
                   class="rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-ink-900 focus:border-fox-500 focus:outline-none focus:ring-2 focus:ring-fox-500/30" />
          </label>

          <button id="send-btn" type="submit"
                  class="rounded-xl bg-fox-500 px-5 py-3 font-semibold text-white transition-colors hover:bg-fox-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-fox-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60">
            Kirim
          </button>
        </form>

        <p id="status" role="status" class="mt-4 min-h-[1.5rem] break-all text-sm text-slate-600"></p>
      </div>
    </main>
  </div>

  <script src="/vendor/ethers.js"></script>
  <script src="/js/wallet-info.js"></script>
  <script src="/js/transfer.js"></script>
</body>
</html>
